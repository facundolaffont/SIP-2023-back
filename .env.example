#######################################################
### Archivo de configuración para el entorno local. ###
#######################################################

# Nivel del log (p.e., DEBUG, INFO).
LOG_LEVEL=

# Puerto de escucha de este server.
PORT=

# Origen permitido como cliente.
CLIENT_ORIGIN_URL=

# Applications > Applications > «NOMBRE APLICACIÓN» > Settings > Basic Information > Domain.
AUTH0_DOMAIN=

# Applications > Applications > «NOMBRE APLICACIÓN» > Settings > Basic Information > Client ID.
AUTH0_APP_CLIENT_ID=

# Applications > Applications > «NOMBRE APLICACIÓN» > Settings > Basic Information > Client Secret.
AUTH0_APP_SECRET=

# Applications > APIs > «NOMBRE API» > Settings > Identifier.
AUTH0_AUDIENCE=

# Authentication > Database.
AUTH0_DB_CONNECTION=

# User Management > Roles > Docente > Role ID.
AUTH0_ROLID_DOCENTE=

# Credenciales de la BD Postgres.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_URL=

# Configuración para envío de Backups por correo
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
BACKUP_EMAIL_DESTINATION=
BACKUP_COMMAND=
# Cron para ejecución del backup.
# Valor de prueba (cada 10 minutos): 0 */10 * * * *
# Valor productivo definitivo (domingos a las 4 AM): 0 0 4 * * SUN
BACKUP_CRON=0 */10 * * * *

# Redirección de emails (OPCIONAL):
# Si se define una dirección, todos los emails de calificaciones se redirigen a ella (modo simulación).
# Si se deja vacío o no se especifica, los emails se envían a los destinatarios reales (alumnos).
MAIL_OVERRIDE=pruebapasantia1@gmail.com